{
  "name": "document-scanner",
  "private": true,
  "version": "1.0.0",
  "description": "Document Scanner — offline-first, privacy-first document scanner for Android and iOS",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "8.0.2",
    "@aparajita/capacitor-secure-storage": "6.0.1",
    "@capacitor-community/privacy-screen": "5.2.1",
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/camera": "6.1.3",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/ios": "6.2.2",
    "@capacitor/preferences": "6.0.4",
    "@capacitor/share": "6.0.4",
    "@capacitor/splash-screen": "6.0.4",
    "@capacitor/status-bar": "6.0.3",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "jspdf": "4.2.1",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@types/node": "22.19.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.0.0",
    "typescript": "5.7.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
